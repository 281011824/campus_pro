# /opt/campus_pro/campus.env —— campus-website / campus-worker 共用
# 复制为 campus.env 后按需修改；不要提交真实密钥

APP_ENV=prod
APP_LOG_OUTDIR=/opt/campus_pro/logs
DB_PATH=/opt/campus_pro/runtime/dywork.db

# --- Worker / Redis ---
HEAD_TEACHER_WORKBENCH_REDIS_URL=redis://127.0.0.1:6381/0
HEAD_TEACHER_WORKBENCH_REQUEST_QUEUE=head_teacher_workbench:requests
HEAD_TEACHER_WORKBENCH_RESPONSE_PREFIX=head_teacher_workbench:response:
HEAD_TEACHER_WORKBENCH_REQUEST_TIMEOUT_SECONDS=10
HEAD_TEACHER_WORKBENCH_RESPONSE_TTL_SECONDS=60
ENABLE_SCHEDULER=0

# --- 企业微信（mock = 不真实发送）---
WECOM_MODE=mock

# --- 登录 ---
AUTH_COOKIE_SECRET=<32-byte-hex>
LOCAL_LOGIN_USERS=<userid:password,userid:password>
