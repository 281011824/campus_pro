# /opt/school_pro/htw.env  —— 两个 systemd 单元（htw-website / htw-worker）共用
# 实际部署在台式机 10.66.0.4，User=fc 运行，无需 sudo

APP_ENV=prod

# --- 工作台 Redis 契约（website 与 worker 必须一致）---
HEAD_TEACHER_WORKBENCH_REDIS_URL=redis://127.0.0.1:6380/0
HEAD_TEACHER_WORKBENCH_REQUEST_QUEUE=head_teacher_workbench:requests
HEAD_TEACHER_WORKBENCH_RESPONSE_PREFIX=head_teacher_workbench:response:
HEAD_TEACHER_WORKBENCH_REQUEST_TIMEOUT_SECONDS=5
HEAD_TEACHER_WORKBENCH_RESPONSE_TTL_SECONDS=30

# --- Worker ---
# 独立于代码目录，便于代码目录整体替换而不影响数据
DB_PATH=/opt/school_pro/runtime/dywork.db

# --- 会话签名密钥（本地账号登录与企微 OAuth 共用）---
# AUTH_COOKIE_SECRET=请替换为随机32+字节密钥

# --- 本地账号登录（过渡方案；留空即关闭）---
# 格式 userid:sha256hex，多个用英文逗号分隔
# LOCAL_LOGIN_USERS=fc:替换为密码的sha256摘要

# --- 企微 OAuth2（默认关闭；启用需同时满足 4 个值都有）---
WECOM_OAUTH_ENABLED=false
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_OAUTH_SECRET=
# WECOM_OAUTH_REDIRECT_URI=https://你的域名/api/v1/auth/wecom/callback
# WECOM_OAUTH_COOKIE_SECRET=请替换为随机32+字节密钥
