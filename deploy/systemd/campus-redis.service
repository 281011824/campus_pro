[Unit]
Description=campus_pro Redis (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/redis-server --port 6381 --bind 127.0.0.1 --save "" --appendonly no --maxmemory 256mb --maxmemory-policy noeviction
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
