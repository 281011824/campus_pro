[Unit]
Description=campus_pro Worker
After=network-online.target campus-redis.service
Wants=network-online.target
Requires=campus-redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/campus_pro
EnvironmentFile=/opt/campus_pro/campus.env
ExecStart=/opt/campus_pro/website/.venv/bin/python -m tasks.interfaces.worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
