[Unit]
Description=Head Teacher Workbench Redis (loopback only)
After=network-online.target

[Service]
Type=simple
User=fc
# 独立实例，不复用系统 6379（带 requirepass），只监听 127.0.0.1
ExecStart=/usr/bin/redis-server \
    --port 6380 \
    --bind 127.0.0.1 \
    --save "" \
    --appendonly no \
    --maxmemory 256mb \
    --maxmemory-policy noeviction
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
