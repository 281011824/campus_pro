[Unit]
Description=Head Teacher Workbench Website (FastAPI)
After=network-online.target wg-quick@wg0.service htw-redis.service
Wants=network-online.target
Requires=htw-redis.service

[Service]
Type=simple
User=fc
WorkingDirectory=/opt/school_pro/website
EnvironmentFile=/opt/school_pro/htw.env
ExecStart=/opt/school_pro/website/.venv/bin/uvicorn app.main:app \
    --host 10.66.0.4 --port 5004 \
    --workers 2 \
    --proxy-headers --forwarded-allow-ips 10.66.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
