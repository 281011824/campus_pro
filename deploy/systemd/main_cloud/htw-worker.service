[Unit]
Description=Head Teacher Workbench Worker (Redis consumer, main cloud)
After=network-online.target htw-redis.service
Wants=network-online.target
Requires=htw-redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/school_pro
EnvironmentFile=/opt/school_pro/htw.env
# 单实例：SQLite 写入与队列顺序都依赖单消费者
ExecStart=/opt/school_pro/website/.venv/bin/python -m tasks.interfaces.worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
