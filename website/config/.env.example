# 网站私密配置模板
# 使用方式：cp .env.example .env && chmod 600 .env
# 系统环境变量优先；.env 只补缺失项，且已被 .gitignore 忽略
APP_ENV=dev
# Redis 需要密码时，把密码写进 URL（不要写进 YAML）：
# HEAD_TEACHER_WORKBENCH_REDIS_URL=redis://:password@127.0.0.1:6379/0

# ---- 本地账号登录（过渡方案；留空即关闭）----
# 格式 userid:sha256hex，多个用英文逗号分隔
# 生成摘要：python -c "import hashlib;print(hashlib.sha256(b'你的密码').hexdigest())"
# LOCAL_LOGIN_USERS=fc:替换为密码的sha256摘要
# 会话签名密钥（本地登录与企微 OAuth 共用），必须是随机长串
# AUTH_COOKIE_SECRET=随机长串，用于会话签名

# ---- 企业微信 OAuth2（不接入就保持注释）----
# 必须同时具备：已备案的可信域名、HTTPS、企微应用凭据
# WECOM_OAUTH_ENABLED=true
# WECOM_CORP_ID=ww1234567890abcdef
# WECOM_AGENT_ID=1000002
# WECOM_SECRET=应用 Secret
# WECOM_OAUTH_REDIRECT_URI=https://your-domain.example/api/v1/auth/wecom/callback
